  m_Script: {fileID: 11500000, guid: 395ad4483d2f2af4e9eabac2fc9549f8, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PaperQuestion
  questionText: {fileID: 2029036657}
  yesText: {fileID: 4175144}
  noText: {fileID: 31178724}
  questionLine: Do you sometimes have difficulties completing your work?
  yesAnswer: 'It is normal to feel unmotivated at times while doing your work.  <br>
    However, for someone with mental health difficulties, they might experience a
    greater drop in motivation and energy levels for longer periods.  '
  noAnswer: "Well that's great!, keep up with that kind of positivity! <br> When
    a young person is not attending school or not doing well at school,  they might
    be viewed as \u201Clazy\u201D or \u201Cunmotivated\u201D. <br> While you might
    not have experienced many difficulties completing your work, however, <br> someone
    with mental health difficulties might experience a greater drop in motivation
    and energy levels, preventing them from completing their work. "
  gestureDetector: {fileID: 1630459157}
  typewriterEffect: {fileID: 2029036659}
  yesLabel: Yes
  noLabel: No
